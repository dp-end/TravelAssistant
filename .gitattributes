# Normalise line endings: store LF in the repo, check out LF everywhere.
# Shell scripts, Dockerfiles and Makefiles break inside Linux containers with CRLF.
* text=auto eol=lf

# Keep Windows-only scripts with CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
